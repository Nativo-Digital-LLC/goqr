{
	"hosting": {
		"public": "dist",
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"headers": [
			{
				"source": "**/@(*.html|!(*.*))",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			},
			{
				"source": "/",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			}
		],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"emulators": {
		"firestore": {
			"port": 8080
		},
		"storage": {
			"port": 9199
		}
	}
}
