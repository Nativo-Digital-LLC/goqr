rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsEstablishment(estId) {
      return signedIn()
        && get(/databases/$(database)/documents/establishments/$(estId)).data.userId == request.auth.uid;
    }

    // Lectura pública de todo excepto `users`. Las reglas se suman (OR), por eso el comodín excluye `users`.
    match /{collection}/{document=**} {
      allow read: if collection != 'users';
    }

    match /establishments/{establishmentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['billing', 'isActive']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billing', 'isActive', 'userId']);
      allow delete: if false;
    }

    match /establishments/{stablishmentId}/categories/{docId} {
      allow write: if ownsEstablishment(stablishmentId);
    }

    match /establishments/{stablishmentId}/categories/{catId}/subcategories/{docId} {
      allow write: if ownsEstablishment(stablishmentId);
    }

    match /products/{docId} {
      allow create: if ownsEstablishment(request.resource.data.establishmentId);
      allow update: if ownsEstablishment(resource.data.establishmentId)
        && request.resource.data.establishmentId == resource.data.establishmentId;
      allow delete: if false;
    }

    match /migrated-users/{email} {
      allow write: if signedIn() && request.auth.token.email.lower() == email;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
